{
  "name": "shinycolors-zh",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "description": "偶像大师闪耀色彩（ShinyColors）网页版汉化脚本与翻译数据发布流水线",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Yiyiko/ShinyColors-zh.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:recon": "vite build --config vite.recon.config.ts",
    "dev:recon": "pnpm run build:recon && tsx scripts/dev-server.ts",
    "pipeline:sync": "tsx pipeline/sync-upstream.ts",
    "pipeline:lint": "tsx pipeline/lint.ts",
    "pipeline:build": "tsx pipeline/build.ts",
    "pipeline:deploy": "tsx pipeline/deploy-gh-pages.ts",
    "pipeline:ai": "tsx pipeline/translate-ai.ts",
    "pipeline:all": "pnpm run pipeline:sync && pnpm run pipeline:lint && pnpm run build && pnpm run pipeline:build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "papaparse": "^5.5.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/papaparse": "^5.3.16",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^8.4.0",
    "vite-plugin-monkey": "^8.1.1",
    "vitest": "^5.1.2"
  }
}
